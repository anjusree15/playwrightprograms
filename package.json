{
  "name": "playwright-pgms",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "headed": "npx playwright test --headed",
    "config": "npx playwright test --config=playwright.config1.js",
    "chrome": "npx playwright test --config=playwright.config1.js --project=chrome_project",
    "debug": "npx playwright test --debug",
    "safari": "npx playwright test --config=playwright.config1.js --project=safari_project",
    "UImode": "npx playwright test --ui",
    "webandtag": "npx playwright test --grep '(?=.*@web)(?=.*@tag)'",
    "webortag": "npx playwright test --grep '(?=.*@web)|(?=.*@tag)'",
    "web": "npx playwright test -- grep web",
    "removeDir": "rmdir /s /q allure-results ",
    "allure": "npx allure generate allure-results --clean  -o allure-report && npx allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
